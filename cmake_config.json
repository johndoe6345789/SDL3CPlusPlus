{
  "project": {
    "name": "SDL3App",
    "cmake_minimum_version": "3.24",
    "default_build_type": "Release",
    "cxx_standard": 20,
    "description": "SDL3 GPU 2D/3D game engine with workflow system"
  },
  "options": [
    {
      "name": "BUILD_SDL3_APP",
      "type": "BOOL",
      "default": "ON",
      "description": "Build the SDL3 GPU demo"
    },
    {
      "name": "ENABLE_CLANG_TIDY",
      "type": "BOOL",
      "default": "OFF",
      "description": "Automatically run clang-tidy on every target"
    },
    {
      "name": "SDL_VERSION",
      "type": "STRING",
      "default": "SDL3",
      "description": "SDL version to use",
      "allowed_values": [
        "SDL3",
        "sdl"
      ]
    }
  ],
  "test_defaults": {
    "include_directories": [
      "src"
    ],
    "link_libraries": [
      "GTest::gtest_main",
      "GTest::gmock",
      "glm::glm",
      "Bullet::Bullet",
      "EnTT::EnTT"
    ]
  },
  "dependencies": {
    "always": [
      "SDL3",
      "RapidJSON",
      "nlohmann_json",
      "Bullet",
      "glm",
      "stb",
      "EnTT",
      "assimp",
      "libzip",
      "spdlog",
      "GTest",
      "ZLIB",
      "ffmpeg"
    ]
  },
  "source_exclusions": [
    "tests/"
  ],
  "targets": [
    {
      "type": "executable",
      "sources": [
        "src/main.cpp",
        "src/services/impl/diagnostics/logger_service_levels.cpp",
        "src/services/impl/diagnostics/logger_service_construct.cpp",
        "src/services/impl/diagnostics/logger_service_config.cpp",
        "src/services/impl/diagnostics/logger_service_log.cpp",
        "src/services/impl/diagnostics/logger_service_trace_variable.cpp",
        "src/services/impl/app/cli_env_override.cpp",
        "src/services/impl/app/app_cli_args.cpp",
        "src/services/impl/app/app_require_package.cpp",
        "src/services/impl/app/app_logger_init.cpp",
        "src/services/impl/app/app_workflow_runtime.cpp",
        "src/services/impl/app/app_package_config.cpp",
        "src/services/impl/app/app_context_populate.cpp",
        "src/services/impl/workflow/bootstrap/*.cpp",
        "src/services/impl/workflow/executor/*.cpp",
        "src/services/impl/workflow/media/*.cpp",
        "src/services/impl/workflow/network/*.cpp",
        "src/services/impl/workflow/parser/*.cpp",
        "src/services/impl/workflow/registrar/*.cpp",
        "src/services/impl/workflow/shader/*.cpp",
        "src/services/impl/workflow/system/*.cpp",
        "src/stb_image.cpp",
        "src/services/impl/workflow/workflow_generic_steps/*.cpp",
        "src/services/impl/workflow/geometry/*.cpp",
        "src/services/impl/workflow/rendering/*.cpp",
        "src/services/impl/workflow/graphics/*.cpp",
        "src/services/impl/workflow/input/*.cpp",
        "src/services/impl/workflow/scene/*.cpp",
        "src/services/impl/workflow/compute/*.cpp",
        "src/services/impl/workflow/quake3/**/*.cpp",
        "src/services/impl/workflow/gta5/**/*.cpp",
        "src/services/impl/workflow/fs2024/*.cpp"
      ],
      "include_directories": [
        "src"
      ],
      "link_libraries": [
        "${SDL_TARGET}",
        "rapidjson",
        "nlohmann_json::nlohmann_json",
        "Bullet::Bullet",
        "glm::glm",
        "stb::stb",
        "EnTT::EnTT",
        "libzip::zip",
        "assimp::assimp",
        "spdlog::spdlog",
        "ZLIB::ZLIB",
        "ffmpeg::avformat",
        "ffmpeg::avcodec",
        "ffmpeg::swscale",
        "ffmpeg::swresample",
        "ffmpeg::avutil"
      ],
      "compile_definitions": [],
      "name": "sdl3_app",
      "enabled_when": "BUILD_SDL3_APP"
    },
    {
      "type": "executable",
      "name": "fs2024_prepare",
      "sources": [
        "src/services/impl/workflow/fs2024/prepare/*.cpp",
        "src/services/impl/workflow/fs2024/fs2024_polygon.cpp",
        "src/services/impl/workflow/fs2024/fs2024_building_mesh.cpp",
        "src/services/impl/workflow/fs2024/fs2024_tile_key.cpp"
      ],
      "include_directories": [
        "src"
      ],
      "link_libraries": [
        "nlohmann_json::nlohmann_json",
        "glm::glm",
        "stb::stb",
        "ZLIB::ZLIB"
      ],
      "compile_definitions": []
    }
  ],
