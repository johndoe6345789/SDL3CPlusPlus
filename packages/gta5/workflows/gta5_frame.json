{
  "name": "GTA V Frame Tick",
  "description": "Per-frame composition: input, streaming, movement, then the draw.",
  "steps": [
    {
      "id": "input_group",
      "plugin": "workflow.include",
      "parameters": {
        "path": "packages/quake3/workflows/q3_input.json"
      },
      "comment": "The input group is reused verbatim from quake3. It only produces move/look/jump/crouch intent, which is exactly what the q3.pm.* steps consume, so there is nothing GTA-specific to restate."
    },
    {
      "id": "physics_group",
      "plugin": "workflow.include",
      "parameters": {
        "path": "packages/gta5/workflows/gta5_physics.json"
      }
    },
    {
      "id": "streaming_group",
      "plugin": "workflow.include",
      "parameters": {
        "path": "packages/gta5/workflows/gta5_streaming.json"
      },
      "comment": "Streaming runs after movement so it centres on the origin this frame produced rather than the last one's."
    },
    {
      "id": "vehicle_spawn",
      "plugin": "gta5.vehicle.spawn",
      "parameters": {
        "model": "D:/gta5_export/models/taxi.gltf",
        "x": 190,
        "y": 34,
        "z": 940,
        "mass": 1600
      },
      "comment": "Spawns once, and only after a tile has streamed in: a car dropped into an empty world falls straight through."
    },
    {
      "id": "vehicles_sync",
      "plugin": "gta5.vehicles.sync"
    },
    {
      "id": "render_prepare",
      "plugin": "render.prepare"
    },
    {
      "id": "frame_begin",
      "plugin": "frame.gpu.begin"
    },
    {
      "id": "tiles_draw",
      "plugin": "gta5.tiles.draw",
      "parameters": {
        "pipeline_key": "gpu_pipeline_gta5",
        "texture_key": "walls_texture_gpu",
        "sampler_key": "walls_texture_sampler"
      }
    },
    {
      "id": "frame_end",
      "plugin": "frame.gpu.end_scene"
    },
    {
      "id": "composite_draw",
      "plugin": "postfx.composite_draw",
      "comment": "Blits the scene target to the swapchain. Without this and the submit below, the draws land in a texture nobody presents and the window stays black."
    },
    {
      "id": "command_buffer_submit",
      "plugin": "gpu.command_buffer_submit"
    },
    {
      "id": "composite_finish",
      "plugin": "postfx.composite_finish"
    }
  ]
}
