{
  "name": "Racer Frame Tick",
  "description": "One frame: input, pod physics, lap timing, camera, then the scene and HUD.",
  "steps": [
    {
      "id": "frame_delta",
      "plugin": "time.frame_delta"
    },
    {
      "id": "input_poll",
      "plugin": "input.poll"
    },
    {
      "id": "keyboard_poll",
      "plugin": "input.keyboard.poll"
    },
    {
      "id": "drive_axes",
      "plugin": "input.axis.combine",
      "parameters": {
        "config_path": "packages/racer/config/input_aggregation.json"
      }
    },
    {
      "id": "drive_buttons",
      "plugin": "input.button.combine",
      "parameters": {
        "config_path": "packages/racer/config/input_aggregation.json"
      }
    },
    {
      "id": "stop_game_loop",
      "plugin": "value.set_if",
      "inputs": {
        "condition": "racer.quit_pressed"
      },
      "parameters": {
        "value": false
      },
      "outputs": {
        "value": "game_running"
      }
    },
    {
      "id": "stop_outer_loop",
      "plugin": "value.set_if",
      "inputs": {
        "condition": "racer.quit_pressed"
      },
      "parameters": {
        "value": false
      },
      "outputs": {
        "value": "outer_running"
      }
    },
    {
      "id": "drive",
      "plugin": "racer.pod.drive",
      "parameters": {
        "autopilot": "${env:RACER_AUTOPILOT}"
      }
    },
    {
      "id": "lap_timer",
      "plugin": "racer.lap.timer"
    },
    {
      "id": "chase_camera",
      "plugin": "racer.camera.chase",
      "parameters": {
        "distance": 20.0,
        "height": 6.0,
        "lead": 25.0,
        "fov": 70.0,
        "far": 6000.0
      }
    },
    {
      "id": "render_prepare",
      "plugin": "render.prepare"
    },
    {
      "id": "frame_begin",
      "plugin": "frame.gpu.begin",
      "parameters": {
        "clear_r": 0.78,
        "clear_g": 0.7,
        "clear_b": 0.58
      }
    },
    {
      "id": "draw_scene",
      "plugin": "racer.scene.draw"
    },
    {
      "id": "end_scene",
      "plugin": "frame.gpu.end_scene"
    },
    {
      "id": "overlay_fps_init",
      "plugin": "overlay.fps_init"
    },
    {
      "id": "overlay_fps_upload_quad",
      "plugin": "overlay.fps_upload_quad"
    },
    {
      "id": "hud_text",
      "plugin": "racer.hud.text"
    },
    {
      "id": "overlay_fps_draw",
      "plugin": "overlay.fps_draw"
    },
    {
      "id": "shot_frame",
      "plugin": "value.literal",
      "comment": "Frame to save a screenshot on (about three seconds in). Nothing is written unless RACER_SHOT names a file.",
      "parameters": {
        "value": 180.0
      },
      "outputs": {
        "value": "racer_shot_frame"
      }
    },
    {
      "id": "shot_due",
      "plugin": "compare.gte",
      "inputs": {
        "left": "loop.iteration",
        "right": "racer_shot_frame"
      },
      "outputs": {
        "value": "racer_shot_due"
      }
    },
    {
      "id": "shot_path",
      "plugin": "value.set_if",
      "inputs": {
        "condition": "racer_shot_due"
      },
      "parameters": {
        "value": "${env:RACER_SHOT}"
      },
      "outputs": {
        "value": "gpu_screenshot_output_path"
      }
    },
    {
      "id": "no_postfx",
      "plugin": "value.literal",
      "comment": "This package draws straight to the swapchain with no postfx composite, so the capture step's swapchain read-back is the right one.",
      "parameters": {
        "value": "missing"
      },
      "outputs": {
        "value": "postfx_composite_state"
      }
    },
    {
      "id": "gpu_screenshot_capture",
      "plugin": "gpu.screenshot_capture",
      "comment": "A swapchain read-back of the frame the engine drew; silent when no path is set."
    },
    {
      "id": "submit",
      "plugin": "gpu.command_buffer_submit"
    }
  ]
}
