{
  "name": "Q3 Overlay",
  "description": "SDL software overlay: FPS counter, HUD, crosshair, hitmarker, menu, map-select. Composable like a React component.",
  "steps": [
    {
      "id": "overlay_fps_init",
      "plugin": "overlay.fps_init"
    },
    {
      "id": "overlay_fps_upload_quad",
      "plugin": "overlay.fps_upload_quad"
    },
    {
      "id": "overlay_fps_upload_text",
      "plugin": "overlay.fps_upload_text"
    },
    {
      "id": "overlay_fps_draw",
      "plugin": "overlay.fps_draw"
    },
    {
      "id": "overlay_begin",
      "plugin": "overlay.sw.begin",
      "parameters": {
        "vert_shader_path_msl":   "packages/quake3/shaders/msl/overlay.vert.metal",
        "frag_shader_path_msl":   "packages/quake3/shaders/msl/overlay.frag.metal",
        "vert_shader_path_spirv": "packages/quake3/shaders/spirv/overlay.vert.spv",
        "frag_shader_path_spirv": "packages/quake3/shaders/spirv/overlay.frag.spv"
      }
    },
    {
      "id": "q3_hud_head",
      "plugin": "q3.hud_head_render"
    },
    {
      "id": "q3_hud",
      "plugin": "q3.hud"
    },
    {
      "id": "q3_crosshair",
      "plugin": "q3.crosshair"
    },
    {
      "id": "q3_hitmarker",
      "plugin": "q3.hitmarker"
    },
    {
      "id": "q3_menu_frame",
      "plugin": "q3.menu.frame"
    },
    {
      "id": "q3_mapselect",
      "plugin": "q3.mapselect"
    },
    {
      "id": "overlay_end_init",
      "plugin": "overlay.sw.end_init"
    },
    {
      "id": "overlay_end_upload_surface",
      "plugin": "overlay.sw.end_upload_surface"
    },
    {
      "id": "overlay_end_upload_quad",
      "plugin": "overlay.sw.end_upload_quad"
    },
    {
      "id": "overlay_end_draw",
      "plugin": "overlay.sw.end_draw"
    },
    {
      "id": "overlay_end_blit_head",
      "plugin": "overlay.sw.end_blit_head"
    },
    {
      "id": "overlay_end_screenshot",
      "plugin": "overlay.sw.end_screenshot"
    }
  ]
}
