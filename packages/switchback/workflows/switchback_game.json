{
  "name": "Switchback",
  "active": true,
  "settings": {
    "executionTimeout": 0
  },
  "variables": {
    "window_width": {
      "name": "window_width",
      "type": "number",
      "defaultValue": 1280
    },
    "window_height": {
      "name": "window_height",
      "type": "number",
      "defaultValue": 960
    },
    "window_title": {
      "name": "window_title",
      "type": "string",
      "defaultValue": "Switchback"
    },
    "renderer_type": {
      "name": "renderer_type",
      "type": "string",
      "defaultValue": "auto"
    },
    "present_mode": {
      "name": "present_mode",
      "type": "string",
      "defaultValue": "mailbox"
    }
  },
  "nodes": [
    {
      "id": "sdl_init",
      "type": "sdl.init",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "id": "sdl_window",
      "type": "sdl.window.create",
      "typeVersion": 1,
      "position": [200, 0]
    },
    {
      "id": "gpu_init_viewport",
      "type": "graphics.gpu.init_viewport",
      "typeVersion": 1,
      "position": [400, 0],
      "parameters": {
        "present_mode": "auto",
        "inputs": {"width": "window_width", "height": "window_height"},
        "outputs": {"viewport_config": "viewport_config"}
      }
    },
    {
      "id": "gpu_init_renderer",
      "type": "graphics.gpu.init_renderer",
      "typeVersion": 1,
      "position": [600, 0],
      "parameters": {
        "inputs": {"renderer_type": "renderer_type"},
        "outputs": {"selected_renderer": "selected_renderer"}
      }
    },
    {
      "id": "gpu_init",
      "type": "graphics.gpu.init",
      "typeVersion": 1,
      "position": [800, 0],
      "parameters": {
        "inputs": {
          "viewport_config": "viewport_config",
          "selected_renderer": "selected_renderer"
        },
        "outputs": {"gpu_handle": "gpu_handle"}
      }
    },
    {
      "id": "physics_world",
      "type": "physics.world.create",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {
        "force_update_all_aabbs": 0
      }
    },
    {
      "id": "ground",
      "type": "physics.body.add",
      "typeVersion": 1,
      "position": [200, 200],
      "parameters": {
        "name": "ground",
        "shape": "box",
        "mass": 0,
        "pos_x": 0.0,
        "pos_y": -0.5,
        "pos_z": 0.0,
        "size_x": 200.0,
        "size_y": 1.0,
        "size_z": 200.0,
        "comment": "Flat test plane with its top at y = 0. Replaced by the Spiral Pass terrain once that exists."
      }
    },
    {
      "id": "assets_index",
      "type": "gta5.assets.index",
      "typeVersion": 1,
      "position": [400, 200],
      "parameters": {
        "map_dir": "${env:GTA5_DATA_DIR}/levels/gta5",
        "config": "packages/gta5/config/gta5_world.json",
        "resource_cache_mb": 8192
      }
    },
    {
      "id": "init_game_running",
      "type": "value.literal",
      "typeVersion": 1,
      "position": [600, 200],
      "parameters": {
        "value": true,
        "outputs": {"value": "game_running"}
      }
    },
    {
      "id": "game_loop",
      "type": "control.loop.while",
      "typeVersion": 1,
      "position": [800, 200],
      "parameters": {
        "condition_key": "game_running",
        "package": "switchback",
        "workflow": "switchback_frame"
      }
    },
    {
      "id": "exit",
      "type": "system.exit",
      "typeVersion": 1,
      "position": [1000, 200]
    }
  ],
  "connections": {
    "sdl_init": {"main": {"0": [{"node": "sdl_window", "type": "main", "index": 0}]}},
    "sdl_window": {"main": {"0": [{"node": "gpu_init_viewport", "type": "main", "index": 0}]}},
    "gpu_init_viewport": {"main": {"0": [{"node": "gpu_init_renderer", "type": "main", "index": 0}]}},
    "gpu_init_renderer": {"main": {"0": [{"node": "gpu_init", "type": "main", "index": 0}]}},
    "gpu_init": {"main": {"0": [{"node": "physics_world", "type": "main", "index": 0}]}},
    "physics_world": {"main": {"0": [{"node": "ground", "type": "main", "index": 0}]}},
    "ground": {"main": {"0": [{"node": "assets_index", "type": "main", "index": 0}]}},
    "assets_index": {"main": {"0": [{"node": "init_game_running", "type": "main", "index": 0}]}},
    "init_game_running": {"main": {"0": [{"node": "game_loop", "type": "main", "index": 0}]}},
    "game_loop": {"main": {"0": [{"node": "exit", "type": "main", "index": 0}]}}
  }
}
