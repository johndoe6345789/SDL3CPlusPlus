{
  "name": "FS2024 Frame",
  "description": "Input, Quake 3 movement over the streamed ground, then streaming, sky, ground and the composite.",
  "steps": [
    {
      "id": "input_group",
      "plugin": "workflow.include",
      "parameters": {
        "path": "packages/fs2024/workflows/fs2024_input.json"
      }
    },
    {
      "id": "physics_group",
      "plugin": "workflow.include",
      "parameters": {
        "path": "packages/fs2024/workflows/fs2024_physics.json"
      }
    },
    {
      "id": "tiles_resolve",
      "plugin": "fs2024.tiles.resolve",
      "comment": "Runs after movement, so it centres on the origin this frame produced rather than the last one's."
    },
    {
      "id": "tiles_load",
      "plugin": "fs2024.tiles.load"
    },
    {
      "id": "tiles_evict",
      "plugin": "fs2024.tiles.evict"
    },
    {
      "id": "render_prepare",
      "plugin": "render.prepare"
    },
    {
      "id": "frame_begin",
      "plugin": "frame.gpu.begin_offscreen",
      "parameters": {
        "render_scale": 1.5
      },
      "comment": "HDR target, supersampled; the composite resolves it and sharpens."
    },
    {
      "id": "sky_draw",
      "plugin": "gta5.sky.draw",
      "parameters": {
        "horizon_r": 0.36,
        "horizon_g": 0.42,
        "horizon_b": 0.52,
        "zenith_r": 0.05,
        "zenith_g": 0.14,
        "zenith_b": 0.42,
        "sun_size": 8.0
      }
    },
    {
      "id": "terrain_draw",
      "plugin": "fs2024.terrain.draw",
      "parameters": {
        "fog_density": 7e-05
      },
      "comment": "Draws every streamed-in tile with its own ground texture; an airport tile's runway markings are drawn sharp by the shader from that tile's own roads.json."
    },
    {
      "id": "frame_end",
      "plugin": "frame.gpu.end_scene"
    },
    {
      "id": "composite_draw",
      "plugin": "postfx.composite_draw"
    },
    {
      "id": "overlay_init",
      "plugin": "postfx.overlay_fps_init"
    },
    {
      "id": "overlay_quad",
      "plugin": "postfx.overlay_fps_upload_quad"
    },
    {
      "id": "overlay_text",
      "plugin": "postfx.overlay_fps_upload_text"
    },
    {
      "id": "overlay_draw",
      "plugin": "postfx.overlay_fps_draw"
    },
    {
      "id": "command_buffer_submit",
      "plugin": "gpu.command_buffer_submit",
      "comment": "Without this the frame lands in a target nobody presents."
    },
    {
      "id": "composite_finish",
      "plugin": "postfx.composite_finish"
    }
  ]
}
