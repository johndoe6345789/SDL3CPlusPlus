{
  "name": "FS2024 Ground",
  "active": true,
  "settings": {
    "executionTimeout": 0
  },
  "variables": {
    "window_width": {
      "name": "window_width",
      "type": "number",
      "defaultValue": 1280
    },
    "window_height": {
      "name": "window_height",
      "type": "number",
      "defaultValue": 960
    },
    "window_title": {
      "name": "window_title",
      "type": "string",
      "defaultValue": "FS2024 - Westminster, London"
    },
    "renderer_type": {
      "name": "renderer_type",
      "type": "string",
      "defaultValue": "auto"
    },
    "present_mode": {
      "name": "present_mode",
      "type": "string",
      "defaultValue": "mailbox"
    },
    "shader_terrain_vert_path": {
      "name": "shader_terrain_vert_path",
      "type": "string",
      "defaultValue": "packages/fs2024/shaders/msl/fs2024_terrain.vert.metal"
    },
    "shader_terrain_frag_path": {
      "name": "shader_terrain_frag_path",
      "type": "string",
      "defaultValue": "packages/fs2024/shaders/msl/fs2024_terrain.frag.metal"
    },
    "shader_sky_vert_path": {
      "name": "shader_sky_vert_path",
      "type": "string",
      "defaultValue": "packages/gta5/shaders/msl/gta5_sky.vert.metal"
    },
    "shader_sky_frag_path": {
      "name": "shader_sky_frag_path",
      "type": "string",
      "defaultValue": "packages/gta5/shaders/msl/gta5_sky.frag.metal"
    },
    "shader_postfx_vert_path": {
      "name": "shader_postfx_vert_path",
      "type": "string",
      "defaultValue": "packages/seed/shaders/msl/postfx_fullscreen.vert.metal"
    },
    "shader_composite_frag_path": {
      "name": "shader_composite_frag_path",
      "type": "string",
      "defaultValue": "packages/gta5/shaders/msl/gta5_composite.frag.metal"
    },
    "shader_ground_frag_path": {
      "name": "shader_ground_frag_path",
      "type": "string",
      "defaultValue": "packages/fs2024/shaders/msl/fs2024_ground.frag.metal"
    },
    "shader_water_vert_path": {
      "name": "shader_water_vert_path",
      "type": "string",
      "defaultValue": "packages/fs2024/shaders/msl/fs2024_water.vert.metal"
    },
    "shader_water_frag_path": {
      "name": "shader_water_frag_path",
      "type": "string",
      "defaultValue": "packages/gta5/shaders/msl/gta5_water.frag.metal"
    }
  },
  "nodes": [
    {
      "id": "sdl_init",
      "type": "sdl.init",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "sdl_window",
      "type": "sdl.window.create",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "gpu_init_viewport",
      "type": "graphics.gpu.init_viewport",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "present_mode": "auto",
        "inputs": {
          "width": "window_width",
          "height": "window_height"
        },
        "outputs": {
          "viewport_config": "viewport_config"
        }
      }
    },
    {
      "id": "gpu_init_renderer",
      "type": "graphics.gpu.init_renderer",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputs": {
          "renderer_type": "renderer_type"
        },
        "outputs": {
          "selected_renderer": "selected_renderer"
        }
      }
    },
    {
      "id": "gpu_init",
      "type": "graphics.gpu.init",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputs": {
          "viewport_config": "viewport_config",
          "selected_renderer": "selected_renderer"
        },
        "outputs": {
          "gpu_handle": "gpu_handle"
        }
      }
    },
    {
      "id": "compile_terrain_vert",
      "type": "graphics.gpu.shader.compile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "stage": "vertex",
        "output_key": "fs2024_terrain_vertex_shader",
        "num_uniform_buffers": 1,
        "num_samplers": 0
      },
      "inputs": {
        "shader_path": "shader_terrain_vert_path"
      }
    },
    {
      "id": "compile_terrain_frag",
      "type": "graphics.gpu.shader.compile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "stage": "fragment",
        "output_key": "fs2024_terrain_fragment_shader",
        "num_uniform_buffers": 1,
        "num_samplers": 1
      },
      "inputs": {
        "shader_path": "shader_terrain_frag_path"
      }
    },
    {
      "id": "create_terrain_pipeline",
      "type": "graphics.gpu.pipeline.create",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "vertex_shader_key": "fs2024_terrain_vertex_shader",
        "fragment_shader_key": "fs2024_terrain_fragment_shader",
        "vertex_format": "position_uv_lmuv_normal",
        "pipeline_key": "gpu_pipeline_fs2024_terrain",
        "color_format": "rgba16_float",
        "release_shaders": 0
      },
      "comment": "Keeps its shaders: the road pipeline, created later, shares them and releases them."
    },
    {
      "id": "compile_sky_vert",
      "type": "graphics.gpu.shader.compile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "stage": "vertex",
        "output_key": "gta5_sky_vertex_shader",
        "num_uniform_buffers": 0,
        "num_samplers": 0
      },
      "inputs": {
        "shader_path": "shader_sky_vert_path"
      }
    },
    {
      "id": "compile_sky_frag",
      "type": "graphics.gpu.shader.compile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "stage": "fragment",
        "output_key": "gta5_sky_fragment_shader",
        "num_uniform_buffers": 1,
        "num_samplers": 0
      },
      "inputs": {
        "shader_path": "shader_sky_frag_path"
      }
    },
    {
      "id": "create_sky_pipeline",
      "type": "graphics.gpu.pipeline.create",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "vertex_shader_key": "gta5_sky_vertex_shader",
        "fragment_shader_key": "gta5_sky_fragment_shader",
        "vertex_format": "none",
        "pipeline_key": "gpu_pipeline_gta5_sky",
        "color_format": "rgba16_float",
        "depth_test": 1,
        "depth_write": 0,
        "has_depth": 1,
        "cull_mode": "none"
      },
      "comment": "The GTA V package's procedural sky, reused as is: it only needs the camera and the sun, and it publishes the horizon colour the ground fogs to."
    },
    {
      "id": "postfx_setup",
      "type": "postfx.setup",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "compile_postfx_vert",
      "type": "graphics.gpu.shader.compile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "stage": "vertex",
        "output_key": "postfx_vertex_shader",
        "num_uniform_buffers": 0,
        "num_samplers": 0
      },
      "inputs": {
        "shader_path": "shader_postfx_vert_path"
      }
    },
    {
      "id": "compile_composite_frag",
      "type": "graphics.gpu.shader.compile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "stage": "fragment",
        "output_key": "fs2024_composite_fragment_shader",
        "num_uniform_buffers": 0,
        "num_samplers": 3
      },
      "inputs": {
        "shader_path": "shader_composite_frag_path"
      }
    },
    {
      "id": "create_composite_pipeline",
      "type": "graphics.gpu.pipeline.create",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "vertex_shader_key": "postfx_vertex_shader",
        "fragment_shader_key": "fs2024_composite_fragment_shader",
        "vertex_format": "none",
        "pipeline_key": "postfx_composite_pipeline",
        "depth_test": 0,
        "depth_write": 0,
        "has_depth": 0,
        "cull_mode": "none"
      }
    },
    {
      "id": "compile_ground_vert",
      "type": "graphics.gpu.shader.compile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "stage": "vertex",
        "output_key": "fs2024_ground_vertex_shader",
        "num_uniform_buffers": 1,
        "num_samplers": 0
      },
      "inputs": {
        "shader_path": "shader_terrain_vert_path"
      },
      "comment": "The terrain vertex shader again, compiled separately: the terrain pipeline releases its own copy once it is built."
    },
    {
      "id": "compile_ground_frag",
      "type": "graphics.gpu.shader.compile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "stage": "fragment",
        "output_key": "fs2024_ground_fragment_shader",
        "num_uniform_buffers": 1,
        "num_samplers": 2
      },
      "inputs": {
        "shader_path": "shader_ground_frag_path"
      }
    },
    {
      "id": "create_ground_pipeline",
      "type": "graphics.gpu.pipeline.create",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "vertex_shader_key": "fs2024_ground_vertex_shader",
        "fragment_shader_key": "fs2024_ground_fragment_shader",
        "vertex_format": "position_uv_lmuv_normal",
        "pipeline_key": "gpu_pipeline_fs2024_ground",
        "color_format": "rgba16_float"
      },
      "comment": "FS2024's own ground: each tile's land-class map picks surfaces out of the game's own material array."
    },
    {
      "id": "compile_water_vert",
      "type": "graphics.gpu.shader.compile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "stage": "vertex",
        "output_key": "fs2024_water_vertex_shader",
        "num_uniform_buffers": 1,
        "num_samplers": 0
      },
      "inputs": {
        "shader_path": "shader_water_vert_path"
      }
    },
    {
      "id": "compile_water_frag",
      "type": "graphics.gpu.shader.compile",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "stage": "fragment",
        "output_key": "fs2024_water_fragment_shader",
        "num_uniform_buffers": 1,
        "num_samplers": 1
      },
      "inputs": {
        "shader_path": "shader_water_frag_path"
      }
    },
    {
      "id": "create_water_pipeline",
      "type": "graphics.gpu.pipeline.create",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "vertex_shader_key": "fs2024_water_vertex_shader",
        "fragment_shader_key": "fs2024_water_fragment_shader",
        "vertex_format": "position_uv_lmuv_normal",
        "pipeline_key": "gpu_pipeline_fs2024_water",
        "color_format": "rgba16_float",
        "alpha_blend": 1,
        "depth_write": 0,
        "cull_mode": "none"
      },
      "comment": "FS2024's own water, shaded as gta5 shades its own: the sky mirrored by Fresnel over a swell, the sun's glint, the haze."
    },
    {
      "id": "create_road_pipeline",
      "type": "graphics.gpu.pipeline.create",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "vertex_shader_key": "fs2024_terrain_vertex_shader",
        "fragment_shader_key": "fs2024_terrain_fragment_shader",
        "vertex_format": "position_uv_lmuv_normal",
        "pipeline_key": "gpu_pipeline_fs2024_road",
        "color_format": "rgba16_float",
        "cull_mode": "none",
        "depth_bias": -1.0
      },
      "comment": "Roads: the terrain shaders, nudged a hair toward the eye. No slope-scaled bias: at grazing angles it pulled distant roads through the buildings in front of them."
    },
    {
      "id": "world_open",
      "type": "fs2024.world.open",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "install_root": "${env:FS2024_INSTALL_DIR}",
        "spawn_lat": "${env:FS2024_SPAWN_LAT}",
        "spawn_lon": "${env:FS2024_SPAWN_LON}",
        "spawn_heading": "${env:FS2024_SPAWN_HEADING}",
        "climate": 2
      },
      "comment": "Opens FS2024's own installed world data and puts engine space on the Earth at the spawn point: every tile after this is cut from the game's files, anywhere on the planet. Also uploads the game's ground material array and bakes the building kit from its generator data."
    },
    {
      "id": "physics_world",
      "type": "physics.world.create",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "force_update_all_aabbs": 0
      }
    },
    {
      "id": "player",
      "type": "physics.body.add",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "name": "player",
        "shape": "capsule",
        "mass": 80,
        "pos_x": 0.0,
        "pos_y": 50.0,
        "pos_z": 0.0,
        "radius": 0.3,
        "height": 1.0,
        "lock_rotation": 1,
        "is_player": 1
      },
      "comment": "Placed properly by spawn below, once the spawn tile is loaded; x, z only matter here so the warm-up streaming below centres on the right tile."
    },
    {
      "id": "player_sync_init",
      "type": "q3.player.sync",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "comment": "Seeds q3.ps from the body's position, so the warm-up resolve below has somewhere to centre on."
    },
    {
      "id": "tiles_resolve_init",
      "type": "fs2024.tiles.resolve",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "root_radius": 2,
        "split": 1.0,
        "lead_seconds": 1.5,
        "finish_budget_ms": 4
      },
      "comment": "Configures the streamer once: a quadtree cut from level-11 tiles (root_radius of them each way) down to FS2024's own level-14 tiles near the camera, a tile splitting while the camera is nearer than split times its width."
    },
    {
      "id": "tiles_load_init",
      "type": "fs2024.tiles.load",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "force": 1
      },
      "comment": "Loads the whole warm-up radius synchronously, so the ground under and around the spawn point exists before the first frame draws or the player can fall through it."
    },
    {
      "id": "camera_setup",
      "type": "camera.setup",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "outputs": {
          "camera_state": "camera.state"
        }
      }
    },
    {
      "id": "spawn",
      "type": "fs2024.player.spawn",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "clearance": 0.3
      },
      "comment": "Stands the player on FS2024's own ground at the spawn point fs2024.world.open placed."
    },
    {
      "id": "lighting",
      "type": "lighting.setup",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "light_dir_x": -0.35,
        "light_dir_y": -0.8,
        "light_dir_z": -0.45,
        "light_intensity": 2.4,
        "ambient_r": 0.42,
        "ambient_g": 0.47,
        "ambient_b": 0.58,
        "ambient_intensity": 0.9,
        "exposure": 0.42
      },
      "comment": "A mid-morning sun from the south-east."
    },
    {
      "id": "init_game_running",
      "type": "value.literal",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "value": true,
        "outputs": {
          "value": "game_running"
        }
      }
    },
    {
      "id": "game_loop",
      "type": "control.loop.while",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "condition_key": "game_running",
        "package": "fs2024",
        "workflow": "fs2024_frame"
      }
    },
    {
      "id": "tiles_free",
      "type": "fs2024.tiles.free",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "comment": "Before system.exit, while the device and the physics world still exist."
    },
    {
      "id": "video_record_stop",
      "type": "video.record.stop",
      "typeVersion": 1,
      "position": [
        -200,
        0
      ],
      "comment": "Finishes a recording once the loop stops: waits for the last frame downloads and writes the file's trailer, without which the video will not play. Needs the GPU device, so it must come before system.exit."
    },
    {
      "id": "exit",
      "type": "system.exit",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    }
  ],
  "connections": {
    "sdl_init": {
      "main": {
        "0": [
          {
            "node": "sdl_window",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "sdl_window": {
      "main": {
        "0": [
          {
            "node": "gpu_init_viewport",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "gpu_init_viewport": {
      "main": {
        "0": [
          {
            "node": "gpu_init_renderer",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "gpu_init_renderer": {
      "main": {
        "0": [
          {
            "node": "gpu_init",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "gpu_init": {
      "main": {
        "0": [
          {
            "node": "compile_terrain_vert",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "compile_terrain_vert": {
      "main": {
        "0": [
          {
            "node": "compile_terrain_frag",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "compile_terrain_frag": {
      "main": {
        "0": [
          {
            "node": "create_terrain_pipeline",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "create_terrain_pipeline": {
      "main": {
        "0": [
          {
            "node": "compile_sky_vert",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "compile_sky_vert": {
      "main": {
        "0": [
          {
            "node": "compile_sky_frag",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "compile_sky_frag": {
      "main": {
        "0": [
          {
            "node": "create_sky_pipeline",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "create_sky_pipeline": {
      "main": {
        "0": [
          {
            "node": "postfx_setup",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "postfx_setup": {
      "main": {
        "0": [
          {
            "node": "compile_postfx_vert",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "compile_postfx_vert": {
      "main": {
        "0": [
          {
            "node": "compile_composite_frag",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "compile_composite_frag": {
      "main": {
        "0": [
          {
            "node": "create_composite_pipeline",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "create_composite_pipeline": {
      "main": {
        "0": [
          {
            "node": "compile_ground_vert",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "physics_world": {
      "main": {
        "0": [
          {
            "node": "player",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "player": {
      "main": {
        "0": [
          {
            "node": "player_sync_init",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "player_sync_init": {
      "main": {
        "0": [
          {
            "node": "tiles_resolve_init",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "tiles_resolve_init": {
      "main": {
        "0": [
          {
            "node": "tiles_load_init",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "tiles_load_init": {
      "main": {
        "0": [
          {
            "node": "camera_setup",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "camera_setup": {
      "main": {
        "0": [
          {
            "node": "spawn",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "spawn": {
      "main": {
        "0": [
          {
            "node": "lighting",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "lighting": {
      "main": {
        "0": [
          {
            "node": "init_game_running",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "init_game_running": {
      "main": {
        "0": [
          {
            "node": "game_loop",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
