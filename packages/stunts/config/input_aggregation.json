{
  "description": "Maps the keyboard and a gamepad to the two axes stunts.car.drive reads. Key names are SDL scancode names as published by input.keyboard.poll.",
  "inputBindings": {
    "axes": {
      "move_forward": {
        "sources": [
          {"type": "key", "key": "Up", "scale": 1.0},
          {"type": "key", "key": "W", "scale": 1.0},
          {"type": "key", "key": "Down", "scale": -1.0},
          {"type": "key", "key": "S", "scale": -1.0},
          {"type": "gamepad_axis", "axis": "left_y", "scale": -1.0,
           "deadzone": 0.15}
        ],
        "outputs": ["input.move_forward"]
      },
      "move_right": {
        "sources": [
          {"type": "key", "key": "Right", "scale": 1.0},
          {"type": "key", "key": "D", "scale": 1.0},
          {"type": "key", "key": "Left", "scale": -1.0},
          {"type": "key", "key": "A", "scale": -1.0},
          {"type": "gamepad_axis", "axis": "left_x", "scale": 1.0,
           "deadzone": 0.15}
        ],
        "outputs": ["input.move_right"]
      }
    },
    "buttons": {
      "quit": {
        "sources": [
          {"type": "key", "key": "Escape"},
          {"type": "gamepad_button", "button": "start"}
        ],
        "outputs": ["stunts.quit_pressed"]
      },
      "camera_toggle": {
        "sources": [
          {"type": "key", "key": "C"},
          {"type": "gamepad_button", "button": "back"}
        ],
        "outputs": ["stunts.camera_toggle_pressed"]
      }
    }
  }
}
