{
  "template": "boot.default",
  "nodes": [
    {
      "id": "load_config",
      "plugin": "config.load",
      "position": [0, 0],
      "inputs": {
        "path": "config.path"
      },
      "outputs": {
        "document": "config.document"
      }
    },
    {
      "id": "validate_schema",
      "plugin": "config.schema.validate",
      "position": [260, 0],
      "inputs": {
        "document": "config.document",
        "path": "config.path"
      }
    },
    {
      "id": "build_runtime",
      "plugin": "runtime.config.build",
      "position": [520, 0],
      "inputs": {
        "document": "config.document",
        "path": "config.path"
      },
      "outputs": {
        "runtime": "config.runtime"
      }
    },
    {
      "id": "validation_probe",
      "plugin": "validation.tour.checkpoint",
      "position": [780, 0],
      "inputs": {
        "checkpoint": "packages.engine_tester"
      }
    }
  ],
  "connections": {
    "load_config": {
      "main": [
        [
          { "node": "validate_schema", "type": "main", "index": 0 }
        ]
      ]
    },
    "validate_schema": {
      "main": [
        [
          { "node": "build_runtime", "type": "main", "index": 0 }
        ]
      ]
    },
    "build_runtime": {
      "main": [
        [
          { "node": "validation_probe", "type": "main", "index": 0 }
        ]
      ]
    }
  }
}
