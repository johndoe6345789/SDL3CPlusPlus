            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "player_sync_init": {
      "main": {
        "0": [
          {
            "node": "tiles_resolve_init",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "tiles_resolve_init": {
      "main": {
        "0": [
          {
            "node": "tiles_load_init",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "tiles_load_init": {
      "main": {
        "0": [
          {
            "node": "camera_setup",
            "type": "main",
