    "tiles_free": {
      "main": {
        "0": [
          {
            "node": "exit",
            "type": "main",
            "index": 0
          }
        ]
      }
    },
    "video_record_stop": {
      "main": {
        "0": [
          {
            "node": "tiles_free",
            "type": "main",
            "index": 0
          }
        ]
      }
    }
  }
}
