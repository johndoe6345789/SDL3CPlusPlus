{
  "schema_version": 2,
  "configVersion": 2,
  "scripts": {
    "entry": "scripts/cube_logic.lua",
    "lua_debug": false
  },
  "runtime": {
    "scene_source": "lua"
  },
  "window": {
    "title": "SDL3 Engine Tester",
    "size": {
      "width": 1280,
      "height": 720
    }
  },
  "rendering": {
    "bgfx": {
      "renderer": "auto"
    }
  },
  "validation_tour": {
    "enabled": true,
    "fail_on_mismatch": true,
    "warmup_frames": 3,
    "capture_frames": 1,
    "output_dir": "artifacts/validation",
    "checkpoints": [
      {
        "id": "startup_spawn",
        "camera": {
          "position": [0.0, 2.0, 5.0],
          "look_at": [0.0, 1.0, 0.0],
          "fov_degrees": 60.0,
          "near": 0.1,
          "far": 100.0
        },
        "checks": [
          {
            "type": "non_black_ratio",
            "threshold": 0.02,
            "min_ratio": 0.01,
            "max_ratio": 1.0
          },
          {
            "type": "luma_range",
            "min_luma": 0.01,
            "max_luma": 0.95
          },
          {
            "type": "mean_color",
            "color": [0.4, 0.45, 0.5],
            "tolerance": 0.25
          },
          {
            "type": "sample_points",
            "points": [
              {
                "x": 0.25,
                "y": 0.25,
                "color": [0.2, 0.3, 0.4],
                "tolerance": 0.35
              },
              {
                "x": 0.5,
                "y": 0.5,
                "color": [0.1, 0.2, 0.6],
                "tolerance": 0.4
              },
              {
                "x": 0.75,
                "y": 0.75,
                "color": [0.8, 0.85, 0.9],
                "tolerance": 0.3
              }
            ]
          }
        ]
      }
    ]
  },
  "config_file": "config/engine_tester_runtime.json"
}
